{
  "name": "jenovate-verification-backend",
  "version": "1.0.0",
  "description": "Jenovate Verification System Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "db:reset": "node -e \"const fs=require('fs'); if(fs.existsSync('./database.sqlite')){fs.unlinkSync('./database.sqlite'); console.log('Database file deleted. Restart server (npm run dev) to create fresh seeded database.');} else {console.log('No database file found.');}\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.3",
    "nodemailer": "^10.0.0",
    "pdfkit": "^0.13.0",
    "sequelize": "^6.35.2",
    "sqlite3": "^5.1.7"
  }
}
